<?xml version="1.0"?>
<sdf version="1.9">
  <model name="vessel1">
    <self_collide>false</self_collide>
    <!-- Avoid links auto-disabling mid-run (can destabilize coupled buoyancy/hydro). -->
    <allow_auto_disable>false</allow_auto_disable>
    <static>false</static>
    <!-- pose units: x,y,z [m], roll,pitch,yaw [rad] — small debug hull (~3.2 m). -->
    <pose>0 0 0.2 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <!-- CoM slightly below geometric center for roll stability (scaled from large vessel). -->
        <pose>0 0 -0.75  0 0 0</pose>
        <mass>380</mass>
        <inertia>
          <!-- kg*m^2; izz lowered for snappier yaw; iyy chosen so ixx+izz >= iyy (valid rigid body). -->
          <ixx>600</ixx>
          <iyy>900</iyy>
          <izz>1500</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="hull_main">
        <pose>0 0 -0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>3.2 1.1 0.5</size>
          </box>
        </geometry>
      </collision>

      <collision name="keel">
        <pose>0 0 -0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>2.8 0.2 0.4</size>
          </box>
        </geometry>
      </collision>

      <visual name="hull_main_visual">
        <pose>0 0 -0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>3.2 1.1 0.5</size>
          </box>
        </geometry>
      </visual>

      <visual name="hull_keel_visual">
        <pose>0 0 -0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>2.8 0.2 0.4</size>
          </box>
        </geometry>
      </visual>
  </link>
 

  <!-- Thruster joints: revolute (1 DOF) required for velocity_control + JointVelocityCmd.
        Prop visuals live on child links so they spin with the shaft (axis +x). -->
  <!-- Stern thrusters: wider Y → larger yaw moment from differential thrust (sim maneuverability). -->
  <!-- <link name="left_thruster">
    <pose>-1.5 -0.5 -0.3 0.0 0.0 0.0</pose>
    <inertial>
      <mass>1e-6</mass>
      <inertia>
        <ixx>1e-6</ixx>
        <iyy>1e-6</iyy>
        <izz>1e-6</izz>
      </inertia>
    </inertial> -->
    <!-- Cylinder default axis is Z; rotate -90° about Y so length aligns with joint +X (thrust). -->
    <!-- <visual name="prop_visual">
      <pose>0.0 0.0 -0.3 0.0 -1.5707963267948966 0.0</pose>
      <geometry>
        <cylinder>
          <radius>0.2</radius>
          <length>0.15</length>
        </cylinder>
      </geometry>
      <material>
        <ambient>0.1 0.1 0.12 1</ambient>
        <diffuse>0.22 0.22 0.26 1</diffuse>
        <specular>0.45 0.45 0.5 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </link> -->

   <!-- MOTOR -->

  <link name="motor_stbd_link">
      <pose degrees="true">-1.6 0.45 -0.8 -90 0 90</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1</iyy>
          <iyz>0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
      <collision name="prop_collision">
        <geometry>
          <mesh>
            <uri>models://meshes/blueboat_prop_stbd.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="prop_visual">
        <geometry>
          <mesh>
            <uri>models://meshes/blueboat_prop_stbd.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.01 0.01 0.01 1</diffuse>
          <ambient>0.01 0.01 0.01 1</ambient>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <metalness>0.5</metalness>
              <roughness>0.5</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
  </link>


  <joint name="motor_stbd_joint" type="fixed">
    <parent>base_link</parent>
    <child>motor_stbd_link</child>
    <axis>
      <xyz>0 0 -1</xyz>
      <!-- <limit>
        <lower>-1e16</lower>
        <upper>1e16</upper>
      </limit> -->
      <dynamics>
        <damping>0.02</damping>
      </dynamics>
    </axis>
  </joint>


  <link name="motor_port_link">
    <pose degrees="true">-1.6 -0.45 -0.8 -90 0 90</pose>
    <inertial>
      <mass>0.2</mass>
      <inertia>
        <ixx>0.1</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.1</iyy>
        <iyz>0</iyz>
        <izz>0.1</izz>
      </inertia>
    </inertial>
    <collision name="prop_collision">
      <geometry>
        <mesh>
          <uri>models://meshes/blueboat_prop_port.dae</uri>
        </mesh>
      </geometry>
    </collision>
    <visual name="prop_visual">
      <geometry>
        <mesh>
          <uri>models://meshes/blueboat_prop_port.dae</uri>
        </mesh>
      </geometry>
      <material>
        <diffuse>0.01 0.01 0.01 1</diffuse>
        <ambient>0.01 0.01 0.01 1</ambient>
        <specular>0.7 0.7 0.7 1</specular>
        <pbr>
          <metal>
            <metalness>0.5</metalness>
            <roughness>0.5</roughness>
          </metal>
        </pbr>
      </material>
    </visual>
  </link>

  <joint name="motor_port_joint" type="fixed">
    <parent>base_link</parent>
    <child>motor_port_link</child>
    <axis>
      <xyz>0 0 -1</xyz>
      <!-- <limit>
        <lower>-1e16</lower>
        <upper>1e16</upper>
      </limit> -->
      <dynamics>
        <damping>0.02</damping>
      </dynamics>
    </axis>
  </joint>


  <!-- Rudder disabled: differential thrust only (no rudder link / joint / position controller).
  <link name="rudder">
    <pose>-1.48 0 -0.07 0 0 0</pose>
    <inertial>
      <mass>0.8</mass>
      <inertia>
        <ixx>0.008</ixx>
        <iyy>0.008</iyy>
        <izz>0.008</izz>
      </inertia>
    </inertial>
    <visual name="rudder_visual">
      <geometry>
        <box>
          <size>0.22 0.05 0.22</size>
        </box>
      </geometry>
      <material>
        <ambient>0.02 0.02 0.02 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </link>

  <joint name="rudder_joint" type="revolute">
    <parent>base_link</parent>
    <child>rudder</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-0.61</lower>
        <upper>0.61</upper>
        <effort>80</effort>
        <velocity>3</velocity>
      </limit>
      <dynamics>
        <damping>1.5</damping>
      </dynamics>
    </axis>
  </joint>
  -->


  <!-- sensors -->
    <link name="imu_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>200.0</update_rate>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <!-- <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit> -->
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>



    <!-- Rudder actuator disabled (see rudder link comment above).
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_joint</joint_name>
      <sub_topic>rudder_cmd</sub_topic>
      <p_gain>35</p_gain>
      <i_gain>0</i_gain>
      <d_gain>5</d_gain>
      <i_max>6</i_max>
      <i_min>-6</i_min>
      <cmd_max>40</cmd_max>
      <cmd_min>-40</cmd_min>
    </plugin>
    -->

  <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
    <link_name>base_link</link_name>
    <enable>base_link</enable>
     <hydrodynamics>
          <damping_on>1</damping_on>
          <viscous_drag_on>1</viscous_drag_on>
          <pressure_drag_on>1</pressure_drag_on>
    </hydrodynamics>
      <xU>-80</xU>
      <xUU>-150</xUU>

      <yV>-300</yV>
      <yVV>-600</yVV>

      <nR>-400</nR>
      <nRR>-800</nRR>
  </plugin>


  <plugin name="gz::sim::systems::JointStatePublisher"
      filename="gz-sim-joint-state-publisher-system">
  </plugin>

  <plugin name="gz::sim::systems::OdometryPublisher"
      filename="gz-sim-odometry-publisher-system">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
  </plugin>

    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>motor_port_joint</joint_name>
      <thrust_coefficient>1.0</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>0.3</propeller_diameter>
      <velocity_control>0</velocity_control>
      <!-- <max_thrust_cmd>400</max_thrust_cmd> -->
      <use_angvel_cmd>0</use_angvel_cmd>
    </plugin>

  <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
    <joint_name>motor_stbd_joint</joint_name>
    <thrust_coefficient>1.0</thrust_coefficient>
    <fluid_density>1025</fluid_density>
    <propeller_diameter>0.3</propeller_diameter>
    <velocity_control>0</velocity_control>
    <!-- <max_thrust_cmd>400</max_thrust_cmd> -->
    <use_angvel_cmd>0</use_angvel_cmd>
  </plugin>

  <plugin filename="ArduPilotPlugin" name="ArduPilotPlugin">
    <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
    <lock_step>0</lock_step>
    <!-- Bind address inside Gazebo; use 0.0.0.0 (not SITL hostname) for Docker. -->
    <fdm_addr>0.0.0.0</fdm_addr>
    <fdm_port_in>9002</fdm_port_in>
    <!-- Match ardupilot_gazebo iris: ENU world + FLU hull → NED / aircraft body. -->
    <modelXYZToAirplaneXForwardZDown>0 0 0 3.141592653589793 0 0</modelXYZToAirplaneXForwardZDown>
    <gazeboXYZToNED>0 0 0 3.141592653589793 0 1.5707963267948966</gazeboXYZToNED>
    <imuName>imu_sensor</imuName>

    <!--
      port motor cw

      SERVO1_FUNCTION 73 (ThrottleLeft)
      SERVO1_MAX 2000
      SERVO1_MIN 1000
    -->
    <control channel="0">
      <jointName>motor_port_joint</jointName>
      <type>COMMAND</type>
      <cmd_topic>/model/vessel1/joint/motor_port_joint/cmd_thrust</cmd_topic>
      <multiplier>500</multiplier>
      <offset>-0.5</offset>
      <servo_min>1000</servo_min>
      <servo_max>2000</servo_max>
    </control>

    <!--
      stbd motor ccw

      SERVO3_FUNCTION 74 (ThrottleRight)
      SERVO3_MAX 2000
      SERVO3_MIN 1000
    -->
    <control channel="2">
      <jointName>motor_stbd_joint</jointName>
      <type>COMMAND</type>
      <cmd_topic>/model/vessel1/joint/motor_stbd_joint/cmd_thrust</cmd_topic>
      <multiplier>500</multiplier>
      <offset>-0.5</offset>
      <servo_min>1000</servo_min>
      <servo_max>2000</servo_max>
    </control>
  </plugin>

  </model>
</sdf>
