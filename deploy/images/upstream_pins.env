# Upstream sources of the simulator images, pinned so that every worker that builds the
# images locally gets the same simulators. The values are the sources inside the images
# measured in Phase 0 (read from the images on 2026-10-24).
#
# deploy/scripts/build.sh passes each KEY=VALUE line as a docker build argument to every
# Dockerfile that declares ARG KEY, and adds this file to the fingerprint of those images.
# To add an upstream: add its _REPO and _COMMIT lines here, declare both ARGs in the
# Dockerfile that uses them, check out exactly that commit and add an
# org.scenegems.upstream.<name> label. Values must not contain spaces.

# Base image of the SITL and Gazebo images (ubuntu:24.04, multi-architecture index digest).
UBUNTU_BASE_IMAGE=ubuntu:24.04@sha256:c4a8d5503dfb2a3eb8ab5f807da5bc69a85730fb49b5cfca2330194ebcc41c7b

# ArduPilot (SITL image, /opt/ardupilot). Submodules follow the commit's gitlinks.
ARDUPILOT_REPO=https://github.com/ArduPilot/ardupilot.git
ARDUPILOT_COMMIT=feb84ea854c6a8ef8c3a50219ee8d97eeef1b4f2

# ardupilot_gazebo (Gazebo image, /opt/ardupilot_gazebo): pull request 166 (multi-instance
# ArduPilotPlugin fixes) at 503dcb5, a fast-forward of main at the base commit.
ARDUPILOT_GAZEBO_REPO=https://github.com/ArduPilot/ardupilot_gazebo.git
ARDUPILOT_GAZEBO_BASE_COMMIT=082a0fe231f6e63bc8d1598f1cba461d9e2ea7f5
ARDUPILOT_GAZEBO_COMMIT=503dcb58f9979ee5096aa82143e4947bd5a35269

# asv_sim (Gazebo image, /opt/asv_sim, wind and anemometer plugins).
ASV_SIM_REPO=https://github.com/srmainwaring/asv_sim.git
ASV_SIM_COMMIT=52bef01cf504e09f1523a3e529f8c2dd9a80700b

# asv_wave_sim (Gazebo image, /opt/asv_wave_sim, gz-waves1: the wave field and the wave-aware
# buoyancy of worlds with waves). Its Hydrodynamics system is renamed WavesHydrodynamics at build
# time so it loads next to gz-sim's own Hydrodynamics system.
ASV_WAVE_SIM_REPO=https://github.com/srmainwaring/asv_wave_sim.git
ASV_WAVE_SIM_COMMIT=ca8629df4e191235753dfae92ef725d30b923364

# Base images of the design space exploration image (eclipse-temurin 25: JDK for the Gradle build,
# JRE for the runtime; multi-architecture index digests).
TEMURIN_JDK_IMAGE=docker.io/eclipse-temurin:25-jdk@sha256:83f4a7fc27df94dcc7b8de04d14cbbba8da14406f921e966969c3b09000aa507
TEMURIN_JRE_IMAGE=docker.io/eclipse-temurin:25-jre@sha256:ecdc0adb37bde1a281c4d245a3cd535004b1fc8322d560f5b09463b248c81df0

# Refinery fork (design space exploration image, source built in /refinery: the scenegems module).
REFINERY_REPO=https://github.com/fdominik98/refinery.git
REFINERY_COMMIT=9c5a22c4b1021e48c4b7f2fac871c094d47bb14c
