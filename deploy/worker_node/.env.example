# The .env of one worker node instance of one control node, next to its docker-compose.yml. The deployment
# tool writes it from the worker node role of release.json (scenegems_tool.cluster.release.roles):
# the control node's address, the operator's parameters and the release revision. This template
# lists every key. Control node and worker nodes trust the VPN: there is no pairing, token or certificate,
# and the worker node starts before or after its control node and retries until it connects.

# ---- Control node ----
# http://<VPN address>:<SCENEGEMS_API_PORT of the control node> of the control node's cluster API.
SCENEGEMS_CONTROL_NODE_URL=http://10.88.0.2:8443
# The control node id (SCENEGEMS_CONTROL_NODE_ID of the control node); the control node's Welcome must name it.
SCENEGEMS_CONTROL_NODE_ID=control-node
# Port of the control node's cluster broker on the control node's host (SCENEGEMS_BROKER_PORT of the control node).
SCENEGEMS_BROKER_PORT=1883

# ---- This worker node ----
# Name of the worker node, which is also its worker node id on the control node and in Docker names: lowercase
# letters, digits and hyphens, unique among the worker nodes of the same control node.
SCENEGEMS_WORKER_NODE_NAME=worker-1
# Name of the machine the worker node runs on; the deployment tool writes it, and the web UI shows it.
SCENEGEMS_WORKER_NODE_MACHINE=
# What the worker node runs, separated by commas; the deployment tool installs the images of each.
# Vessel stack layers: asv_system/replay, asv_system/usv_navigation, control_layer/none,
# control_layer/ardupilot (SITL), control_layer/custom, simulation_layer/kinematic,
# simulation_layer/ardupilot_sim, simulation_layer/gazebo (Gazebo). Subsystems: scene_generation,
# trajectory_generation, monitoring, calibration, design_space_exploration. A simulation runs on a worker node that has every layer
# of every vessel's stack.
SCENEGEMS_WORKER_NODE_COMPONENTS=asv_system/replay,asv_system/usv_navigation,control_layer/none,simulation_layer/kinematic,scene_generation,trajectory_generation,monitoring,design_space_exploration
# Job types and how many of each run at once (slots). Types: scene_generation,
# trajectory_generation, simulation, monitoring.post_hoc, calibration.deviation, design_space_exploration; each needs a
# component that serves it (simulation a simulation layer, calibration.deviation calibration).
SCENEGEMS_WORKER_NODE_SLOTS=simulation:4,scene_generation:1,trajectory_generation:1,monitoring.post_hoc:2,design_space_exploration:1
# Optional labels jobs can require, as key=value pairs.
SCENEGEMS_WORKER_NODE_LABELS=
# Optional local frame of the pooled services: latitude,longitude,radius in meters.
SCENEGEMS_WORKER_NODE_REFERENCE_GEOFENCE=
# Bound of the cache of downloaded artifacts in the state volume, in bytes (2 GiB); 0 turns it off.
SCENEGEMS_WORKER_NODE_ARTIFACT_CACHE_MAX_BYTES=2147483648

# ---- Release ----
# The release revision the worker node reports to the control node.
SCENEGEMS_SOFTWARE_REVISION=
# Tag of the release's images: scenegems-worker-node and every image the worker node's jobs run in. The release
# revision, with -dirty when it was built from uncommitted changes; latest for images built by ./build.sh.
SCENEGEMS_IMAGE_TAG=latest
# Optional subsystem image overrides; empty means scenegems-<subsystem>:<SCENEGEMS_IMAGE_TAG>.
SCENE_GENERATION_IMAGE=
TRAJECTORY_GENERATION_IMAGE=
MONITORING_IMAGE=
SCENARIO_EXECUTION_IMAGE=
DESIGN_SPACE_EXPLORATION_IMAGE=
