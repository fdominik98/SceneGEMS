{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of the SceneGEMS chart",
  "description": "Refuses a values file the system cannot run. The names and forms follow the code: scope_names.py (cluster and worker node names), worker_node_configuration.py (components, slots, labels), fingerprints/components.py and protocol/jobs.py (the lists), subsystem.py and the vessel stack (the image variables); tests/scenegems_tool/cluster/release/test_stack_contract.py keeps them equal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["controlNodeId", "revision", "imageTag", "imagePullPolicy", "images", "workerNodeImages", "controlNode", "workerNodeHostPath", "networkPolicy", "workerNodeDefaults", "workerNodes"],
  "definitions": {
    "scopeName": {
      "description": "A cluster id: 1 to 63 lowercase letters, digits and hyphens, starting and ending with a letter or digit",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "workerNodeName": {
      "description": "A worker node's name: 1 to 28 lowercase letters, digits and hyphens, starting and ending with a letter or digit, since the names of its Deployments start with it and Kubernetes takes at most 63 characters",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,26}[a-z0-9])?$"
    },
    "nodeName": {
      "description": "A Kubernetes node's name (a DNS subdomain)",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
    },
    "image": {
      "description": "Empty for <repository>:<imageTag>, else an image reference used as it is (repository:tag or registry/repository@sha256:<digest>)",
      "type": "string",
      "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._/:@-]*)$"
    },
    "component": {
      "type": "string",
      "enum": [
        "asv_system/mission_planner",
        "asv_system/moos_ivp",
        "asv_system/on_board",
        "asv_system/replay",
        "asv_system/usv_navigation",
        "calibration",
        "control_layer/ardupilot",
        "control_layer/custom",
        "control_layer/none",
        "control_layer/real_vessel",
        "design_space_exploration",
        "monitoring",
        "scene_generation",
        "simulation_layer/ardupilot_sim",
        "simulation_layer/gazebo",
        "simulation_layer/kinematic",
        "simulation_layer/real_vessel",
        "trajectory_generation"
      ]
    },
    "jobType": {
      "type": "string",
      "enum": ["design_space_exploration", "scene_generation", "trajectory_generation", "simulation", "monitoring.post_hoc", "calibration.deviation"]
    },
    "workerNodeFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "node": {"type": "string"},
        "machine": {"type": "string", "maxLength": 256},
        "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/component"}},
        "slots": {
          "description": "Job type to how many jobs of it run at once, at least 1",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/definitions/jobType"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "labels": {
          "type": "object",
          "propertyNames": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "additionalProperties": {"type": ["string", "number", "boolean"], "pattern": "^[^,]+$"}
        },
        "artifactCacheMaxBytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "properties": {
    "controlNodeId": {"$ref": "#/definitions/scopeName"},
    "revision": {"type": "string"},
    "imageTag": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
    "imagePullPolicy": {"type": "string", "enum": ["IfNotPresent", "Always", "Never"]},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlNodeApi", "broker", "postgres", "workerNode"],
      "properties": {
        "controlNodeApi": {"$ref": "#/definitions/image"},
        "broker": {"$ref": "#/definitions/image"},
        "postgres": {"$ref": "#/definitions/image"},
        "workerNode": {"$ref": "#/definitions/image"}
      }
    },
    "workerNodeImages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "DESIGN_SPACE_EXPLORATION_IMAGE": {"$ref": "#/definitions/image"},
        "SCENE_GENERATION_IMAGE": {"$ref": "#/definitions/image"},
        "TRAJECTORY_GENERATION_IMAGE": {"$ref": "#/definitions/image"},
        "MONITORING_IMAGE": {"$ref": "#/definitions/image"},
        "SIMULATION_IMAGE": {"$ref": "#/definitions/image"},
        "SITL_IMAGE": {"$ref": "#/definitions/image"},
        "MAVPROXY_IMAGE": {"$ref": "#/definitions/image"},
        "ARDUAGENT_IMAGE": {"$ref": "#/definitions/image"},
        "GAZEBO_IMAGE": {"$ref": "#/definitions/image"},
        "USV_NAVIGATION_IMAGE": {"$ref": "#/definitions/image"},
        "MOOS_IVP_IMAGE": {"$ref": "#/definitions/image"}
      }
    },
    "controlNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "node", "operatorAllowedOrigins", "artifactMaxBytes", "artifactSweepIntervalS", "artifactSweepGraceS", "storage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "node": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/nodeName"}]},
        "operatorAllowedOrigins": {"type": "string"},
        "artifactMaxBytes": {"type": "integer", "minimum": 1},
        "artifactSweepIntervalS": {"type": "number", "minimum": 0},
        "artifactSweepGraceS": {"type": "number", "minimum": 0},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["className", "postgres", "artifacts"],
          "properties": {
            "className": {"type": "string"},
            "postgres": {"type": "string", "minLength": 1},
            "artifacts": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "workerNodeHostPath": {"type": "string", "pattern": "^/"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "externalBrokerPorts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "externalBrokerPorts": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
      }
    },
    "workerNodeDefaults": {
      "allOf": [{"$ref": "#/definitions/workerNodeFields"}],
      "required": ["name", "node", "machine", "components", "slots", "labels", "artifactCacheMaxBytes"]
    },
    "workerNodes": {
      "type": "array",
      "items": {
        "allOf": [{"$ref": "#/definitions/workerNodeFields"}],
        "required": ["name", "node"],
        "properties": {
          "name": {"$ref": "#/definitions/workerNodeName"},
          "node": {"$ref": "#/definitions/nodeName"}
        }
      }
    }
  }
}
