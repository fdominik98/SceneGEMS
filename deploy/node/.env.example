# The .env of one node instance of one master, next to its docker-compose.yml. The deployment
# tool writes it from the node role of release.json (scenegems_tool.cluster.release.roles):
# the master's address, the operator's parameters and the release revision. This template
# lists every key. Master and nodes trust the VPN: there is no pairing, token or certificate,
# and the node starts before or after its master and retries until it connects.

# ---- Master ----
# http://<VPN address>:<SCENEGEMS_API_PORT of the master> of the master's cluster API.
SCENEGEMS_MASTER_URL=http://10.88.0.2:8443
# The master id (SCENEGEMS_MASTER_ID of the master); the master's Welcome must name it.
SCENEGEMS_MASTER_ID=master
# Port of the master's cluster broker on the master's host (SCENEGEMS_BROKER_PORT of the master).
SCENEGEMS_BROKER_PORT=1883

# ---- This node ----
# Name of the node, which is also its node id on the master and in Docker names: lowercase
# letters, digits and hyphens, unique among the nodes of the same master.
SCENEGEMS_NODE_NAME=worker-1
# Name of the machine the node runs on; the deployment tool writes it, and the web UI shows it.
SCENEGEMS_NODE_MACHINE=
# What the node runs, separated by commas; the deployment tool installs the images of each.
# Vessel stack layers: asv_software/replay, asv_software/usv_navigation, control_layer/none,
# control_layer/ardupilot (SITL), control_layer/custom, simulation_layer/kinematic,
# simulation_layer/ardupilot_sim, simulation_layer/gazebo (Gazebo). Subsystems: scene_generation,
# trajectory_generation, monitoring, calibration. A simulation runs on a node that has every layer
# of every vessel's stack.
SCENEGEMS_NODE_COMPONENTS=asv_software/replay,asv_software/usv_navigation,control_layer/none,simulation_layer/kinematic,scene_generation,trajectory_generation,monitoring
# Job types and how many of each run at once (slots). Types: scene_generation,
# trajectory_generation, simulation, monitoring.post_hoc, calibration.deviation; each needs a
# component that serves it (simulation a simulation layer, calibration.deviation calibration).
SCENEGEMS_NODE_SLOTS=simulation:4,scene_generation:1,trajectory_generation:1,monitoring.post_hoc:2
# Optional labels jobs can require, as key=value pairs.
SCENEGEMS_NODE_LABELS=
# Optional local frame of the pooled services: latitude,longitude,radius in meters.
SCENEGEMS_NODE_REFERENCE_GEOFENCE=
# Bound of the cache of downloaded artifacts in the state volume, in bytes (2 GiB); 0 turns it off.
SCENEGEMS_NODE_ARTIFACT_CACHE_MAX_BYTES=2147483648

# ---- Release ----
# The release revision the node reports to the master.
SCENEGEMS_SOFTWARE_REVISION=
# Tag of the release's images: scenegems-node and every image the node's jobs run in. The release
# revision, with -dirty when it was built from uncommitted changes; latest for images built by ./build.sh.
SCENEGEMS_IMAGE_TAG=latest
# Optional subsystem image overrides; empty means scenegems-<subsystem>:<SCENEGEMS_IMAGE_TAG>.
SCENE_GENERATION_IMAGE=
TRAJECTORY_GENERATION_IMAGE=
MONITORING_IMAGE=
SCENARIO_EXECUTION_IMAGE=
