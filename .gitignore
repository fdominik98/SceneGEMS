# Python build metadata
*.egg-info/

# Real env files hold secrets (control node, worker node); only the .env.example templates are tracked
.env

# npm installs, at any depth (frontend/, frontend/website/, or a stray one anywhere else)
node_modules/

# Frontend
frontend/.env
frontend/dist/
frontend/dist-ssr/
frontend/public/docs/
frontend/website/build/
frontend/website/static/scenegems-ui-documentation.pdf
frontend/*.local

# Architecture description files, generated by the control node at startup
backend/assets/architecture/

# Editor
.DS_Store
.cursor/
.claude/
CLAUDE.md

system_revision

# Control node security folders: CA key, certificates, hashed credentials (SCENEGEMS_SECURITY_DIR)
deploy/control_node/security_data/
