<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Parametric vessel, control layer ardupilot: L 30 m, B 10 m, draft 1.8 m,
       block coefficient 0.6, 332100 kg, full thrust for 24.6933 m/s;
       skid steered by two thrusters of 205267 N each: full differential thrust for 0.06 rad/s.
       Commands: gz.msgs.Double thrust in N on /model/agent_0/joint/motor_port_joint/cmd_thrust, /model/agent_0/joint/motor_stbd_joint/cmd_thrust. -->
  <model name="agent_0">
    <self_collide>false</self_collide>
    <!-- Avoid links auto-disabling mid-run (can destabilize coupled buoyancy/hydro). -->
    <allow_auto_disable>false</allow_auto_disable>
    <static>false</static>
    <!-- Pose is applied by the world via <include><pose> so this model stays reusable. Origin at the waterline. -->

    <link name="base_link">
      <inertial>
        <pose>0 0 -0.9 0 0 0</pose>
        <mass>331213</mass>
        <inertia><ixx>4057350</ixx><iyy>18630700</iyy><izz>18630700</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- Buoyant volume: boxes along the hull with its waterline breadth and mean depth, which displace the
           total mass at the draft (world Buoyancy system). Each is centered on the waterline and split into
           3 or more cells across the hull so that roll is restored (see vessel_dynamics.BUOYANCY_GRID). -->
      <collision name="collision_hull_0_0">
        <pose>-12.8469 -1.02355 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 1.02355 2.24911</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_0_1">
        <pose>-12.8469 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 1.02355 2.24911</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_0_2">
        <pose>-12.8469 1.02355 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 1.02355 2.24911</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_1_0">
        <pose>-9.51355 -2.53457 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 2.53457 2.45867</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_1_1">
        <pose>-9.51355 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 2.53457 2.45867</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_1_2">
        <pose>-9.51355 2.53457 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 2.53457 2.45867</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_2_0">
        <pose>-6.18021 -3.24207 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.24207 2.81528</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_2_1">
        <pose>-6.18021 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.24207 2.81528</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_2_2">
        <pose>-6.18021 3.24207 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.24207 2.81528</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_3_0">
        <pose>-2.84688 -3.33324 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.33324 3.28408</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_3_1">
        <pose>-2.84688 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.33324 3.28408</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_3_2">
        <pose>-2.84688 3.33324 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.33324 3.28408</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_4_0">
        <pose>0.486452 -3.33131 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.33131 3.45468</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_4_1">
        <pose>0.486452 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.33131 3.45468</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_4_2">
        <pose>0.486452 3.33131 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.33131 3.45468</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_5_0">
        <pose>3.81979 -3.19832 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.19832 3.17573</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_5_1">
        <pose>3.81979 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.19832 3.17573</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_5_2">
        <pose>3.81979 3.19832 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 3.19832 3.17573</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_6_0">
        <pose>7.15312 -2.72679 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 2.72679 2.86848</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_6_1">
        <pose>7.15312 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 2.72679 2.86848</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_6_2">
        <pose>7.15312 2.72679 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 2.72679 2.86848</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_7_0">
        <pose>10.4865 -1.89806 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 1.89806 2.61982</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_7_1">
        <pose>10.4865 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 1.89806 2.61982</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_7_2">
        <pose>10.4865 1.89806 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 1.89806 2.61982</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_8_0">
        <pose>13.8198 -0.712105 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 0.712105 2.43283</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_8_1">
        <pose>13.8198 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 0.712105 2.43283</size>
          </box>
        </geometry>
      </collision>
      <collision name="collision_hull_8_2">
        <pose>13.8198 0.712105 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.33333 0.712105 2.43283</size>
          </box>
        </geometry>
      </collision>
      <!-- The hull surface, a mesh next to this file (hull_form.py). -->
      <visual name="visual_hull">
        <geometry>
          <mesh>
            <uri>agent_0_hull.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.25 0.3 0.4 1</ambient>
          <diffuse>0.25 0.3 0.4 1</diffuse>
        </material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>100.0</update_rate>
      </sensor>
    </link>

    <!-- Windage: the world WindEffects system pushes this link with mass * factor * relative wind,
         so its mass is the hull's air drag in N per m/s. Fixed to the hull at the center of the side area above water. -->
    <link name="windage_link">
      <pose>0 0 1.35 0 0 0</pose>
      <enable_wind>true</enable_wind>
      <inertial>
        <mass>223.256</mass>
        <inertia><ixx>1996.1</ixx><iyy>16879.8</iyy><izz>18604.7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="windage_joint" type="fixed">
      <parent>base_link</parent>
      <child>windage_link</child>
    </joint>

    <link name="motor_port_link">
      <pose>-13.5 4 -0.9 0 0 0</pose>
      <inertial>
        <mass>332.1</mass>
        <inertia><ixx>48.4202</ixx><iyy>96.8404</iyy><izz>96.8404</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="motor_port_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor_port_link</child>
      <axis>
        <xyz>1 0 0</xyz> <!-- thrust direction for the Thruster system -->
      </axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>motor_port_joint</joint_name>
      <thrust_coefficient>0.00759909</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>1.08</propeller_diameter>
      <!-- The propeller turns at the speed of the thrust (no propeller PID torque on the hull), and the
           system publishes that speed on .../ang_vel every iteration: the gz-transport actuator checks
           with it that a thrust command was in effect from the step's first iteration. -->
      <velocity_control>1</velocity_control>
      <use_angvel_cmd>0</use_angvel_cmd>
      <max_thrust_cmd>205267</max_thrust_cmd>
      <min_thrust_cmd>-205267</min_thrust_cmd>
    </plugin>

    <link name="motor_stbd_link">
      <pose>-13.5 -4 -0.9 0 0 0</pose>
      <inertial>
        <mass>332.1</mass>
        <inertia><ixx>48.4202</ixx><iyy>96.8404</iyy><izz>96.8404</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="motor_stbd_joint" type="revolute">
      <parent>base_link</parent>
      <child>motor_stbd_link</child>
      <axis>
        <xyz>1 0 0</xyz> <!-- thrust direction for the Thruster system -->
      </axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>motor_stbd_joint</joint_name>
      <thrust_coefficient>0.00759909</thrust_coefficient>
      <fluid_density>1025</fluid_density>
      <propeller_diameter>1.08</propeller_diameter>
      <!-- The propeller turns at the speed of the thrust (no propeller PID torque on the hull), and the
           system publishes that speed on .../ang_vel every iteration: the gz-transport actuator checks
           with it that a thrust command was in effect from the step's first iteration. -->
      <velocity_control>1</velocity_control>
      <use_angvel_cmd>0</use_angvel_cmd>
      <max_thrust_cmd>205267</max_thrust_cmd>
      <min_thrust_cmd>-205267</min_thrust_cmd>
    </plugin>

    <!-- Added-mass Coriolis terms off: their Munk moment makes a bare hull directionally unstable
         (measured: the 5 m hull spun under equal thrust above 2.5 m/s); real hulls are kept
         straight by skegs, which this model does not have. -->
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <disable_coriolis>true</disable_coriolis>
      <xDotU>-16605</xDotU>
      <yDotV>-156498</yDotV>
      <zDotW>-166050</zDotW>
      <nDotR>-9315350</nDotR>
      <xU>-2866.43</xU>
      <yV>-250475</yV>
      <zW>-1049750</zW>
      <kP>-4347360</kP>
      <mQ>-27060600</mQ>
      <nR>-5473790</nR>
      <xUabsU>-557.19</xUabsU>
      <yVabsV>-27675</yVabsV>
      <nRabsR>-364920000</nRabsR>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="ArduPilotPlugin" name="ArduPilotPlugin">
      <robotNamespace>agent_0</robotNamespace>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <fdm_addr>0.0.0.0</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <!-- Match ardupilot_gazebo iris: ENU world + FLU hull to NED / aircraft body. -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141592653589793 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141592653589793 0 1.5707963267948966</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>
      <!-- Port motor, SERVO1_FUNCTION 73 (ThrottleLeft). PWM 1000 to 2000 is full astern to full ahead. -->
      <control channel="0">
        <jointName>motor_port_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/agent_0/joint/motor_port_joint/cmd_thrust</cmd_topic>
        <multiplier>410534</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
      <!-- Starboard motor, SERVO3_FUNCTION 74 (ThrottleRight). -->
      <control channel="2">
        <jointName>motor_stbd_joint</jointName>
        <type>COMMAND</type>
        <cmd_topic>/model/agent_0/joint/motor_stbd_joint/cmd_thrust</cmd_topic>
        <multiplier>410534</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
      </control>
    </plugin>
  </model>
</sdf>
