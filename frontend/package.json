{
  "name": "scenegems-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-docs-dev.mjs && vite --host 0.0.0.0",
    "docs:dev": "npm run start --prefix website",
    "docs:pdf": "node scripts/generate-docs-pdf.mjs",
    "docs:build": "npm run docs:pdf && npm run build --prefix website",
    "prebuild": "node scripts/generate-presets-manifest.mjs",
    "build": "npm run docs:build && node scripts/stage-docs.mjs && tsc -b && vite build",
    "presets:manifest": "node scripts/generate-presets-manifest.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.95.2",
    "@types/leaflet": "^1.9.21",
    "@uiw/react-codemirror": "^4.25.9",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "proj4": "^2.20.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@lezer/generator": "^1.8.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "md-to-pdf": "^5.2.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
